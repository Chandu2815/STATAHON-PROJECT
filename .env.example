# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/mospi_dpi
DATABASE_ECHO=false

# JWT Authentication
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OTP Authentication
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# API Configuration
API_V1_PREFIX=/api/v1
PROJECT_NAME=MoSPI Data Portal Infrastructure
DEBUG=false

# Rate Limiting
RATE_LIMIT_PUBLIC=100/day
RATE_LIMIT_RESEARCHER=1000/day
RATE_LIMIT_PREMIUM=10000/day

# Redis (Optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Payment Gateway (Mock)
PAYMENT_GATEWAY_URL=https://mock-payment-gateway.example.com
PAYMENT_API_KEY=mock-api-key

# CORS - Include your Railway domain
ALLOWED_ORIGINS=https://your-app.railway.app,https://localhost:3000,https://localhost:8000

# Frontend URLs
VITE_APP_URL=https://statquery.in
VITE_SURVEY_AI_URL=https://statquery.in/survey-ai

# Security
SECURE_COOKIES=true

# Logging
LOG_LEVEL=INFO

# SMTP Email (required for OTP in production)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@mospi.gov.in
